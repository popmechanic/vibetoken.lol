{
  "meta": {
    "name": "90% Rev Share Micro Business",
    "description": "Stress test: What happens when founder gives 90% of revenue to token holders? Tests extreme generosity on low-revenue business.",
    "version": "1.0"
  },
  "simulation": {
    "runs": 100,
    "duration_months": 36,
    "seed": null,
    "parallel_batches": 5
  },
  "business": {
    "archetype": "micro",
    "base_mrr": 500,
    "params": {
      "growth_mean": 0.03,
      "growth_stddev": 0.20,
      "spike_probability": 0.08,
      "spike_multiplier": 2,
      "zero_probability": 0.08,
      "failure_threshold": 3
    }
  },
  "tokenomics": {
    "alpha": 0.90,
    "k": 0.005,
    "treasury": 50000,
    "s_min": 1000
  },
  "participants": [
    {
      "id": "founder_friend",
      "name": "Founder's Friend",
      "behavior": "diamond_hands",
      "grant": 8000,
      "referral_share": 0.15,
      "start_month": 1,
      "params": {
        "labor_intensity": 0.3
      }
    },
    {
      "id": "early_adopter",
      "name": "Early Adopter",
      "behavior": "diamond_hands",
      "grant": 5000,
      "referral_share": 0.20,
      "start_month": 1,
      "params": {
        "labor_intensity": 0.4
      }
    },
    {
      "id": "hustler",
      "name": "Hustler",
      "behavior": "hustler",
      "grant": 2000,
      "referral_share": 0.25,
      "start_month": 2,
      "params": {
        "labor_intensity": 0.5,
        "exit_aversion": 0.8
      }
    },
    {
      "id": "rational",
      "name": "Rational Actor",
      "behavior": "rational",
      "grant": 3000,
      "referral_share": 0.10,
      "start_month": 1,
      "params": {
        "discount_rate": 0.06,
        "forecast_horizon": 12,
        "confidence": 0.6,
        "exit_threshold": 0.85
      }
    }
  ]
}
