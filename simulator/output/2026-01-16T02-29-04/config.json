{
  "meta": {
    "name": "Micro Business + Diamond Hands",
    "description": "Small, spiky business with committed holders who never exit. Tests whether patience pays off in high-variance environments.",
    "version": "1.0"
  },
  "simulation": {
    "runs": 10,
    "duration_months": 36,
    "seed": null,
    "parallel_batches": 5
  },
  "business": {
    "archetype": "micro",
    "base_mrr": 1500,
    "params": {
      "growth_mean": 0.03,
      "growth_stddev": 0.35,
      "spike_probability": 0.1,
      "spike_multiplier": 2.5,
      "zero_probability": 0.12,
      "failure_threshold": 3
    }
  },
  "tokenomics": {
    "alpha": 0.2,
    "k": 0.008,
    "treasury": 180000,
    "s_min": 1000
  },
  "participants": [
    {
      "id": "founder_friend",
      "name": "Founder's Friend",
      "behavior": "diamond_hands",
      "grant": 6000,
      "grant_month": 0,
      "referral_share": 0.15,
      "start_month": 1,
      "params": {
        "labor_intensity": 0.3
      }
    },
    {
      "id": "early_adopter",
      "name": "Early Adopter",
      "behavior": "diamond_hands",
      "grant": 6000,
      "grant_month": 0,
      "referral_share": 0.2,
      "start_month": 1,
      "params": {
        "labor_intensity": 0.4
      }
    },
    {
      "id": "committed_holder",
      "name": "Committed Holder",
      "behavior": "diamond_hands",
      "grant": 4000,
      "grant_month": 3,
      "referral_share": 0.05,
      "start_month": 3,
      "params": {
        "labor_intensity": 0.2
      }
    }
  ]
}